# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Vercel CLI writes .vercel/project.json containing orgId/projectId.
.vercel

# Cygwin/MSYS crash dumps
*.stackdump

# Full-fidelity raw API archive (contains internal Discord IDs) — kept locally only.
# The slimmed data actually served lives in server/data/ and IS committed; see the README
# for exactly which fields are retained and which were dropped.
data/raw-snapshot/

# Build intermediate: an enumerated key map of the league's asset bucket, regenerated by
# scripts/build-frozen-data.mjs and consumed by scripts/mirror-images.mjs. Not needed to
# run the site, since the images it points at are already mirrored into public/img/frozen/.
scripts/image-manifest.json
