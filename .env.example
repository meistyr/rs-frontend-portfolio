# Portfolio build — no backend, database, or API token is required.
# The app serves a frozen data snapshot from server/data/ (see README).
#
# Everything below is OPTIONAL:

# Public site URL (used for absolute links/metadata). Vercel sets its own URL if omitted.
# NUXT_PUBLIC_SITE_URL=https://your-portfolio-domain.example

# Session cookie seal key for nuxt-auth-utils. No login flow is exposed on this build,
# so a built-in default is used if this is unset. Override if you want your own key.
# NUXT_SESSION_PASSWORD=change-me-to-at-least-32-characters
