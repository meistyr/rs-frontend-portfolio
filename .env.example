# Royalty Series frontend — example configuration.
# Every value below is a placeholder. Copy to .env and replace before use.
#
# Nothing here is required: the portfolio build serves a frozen data snapshot
# from server/data/ (see README) and needs no backend, database, or API token.

# Public site URL, used for absolute links and metadata.
# Vercel supplies its own URL if this is omitted.
# NUXT_PUBLIC_SITE_URL=https://example.invalid
